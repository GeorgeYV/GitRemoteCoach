DATABASE_URL=postgres://localhost:5432/remote_coach
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
JWT_SECRET=change-me-in-production
# Sin un dominio propio verificado en Resend, el modo sandbox solo entrega correos a la
# dirección dueña de la cuenta de Resend — suficiente para probar el flujo, no para producción.
RESEND_API_KEY=re_...
EMAIL_FROM_ADDRESS=onboarding@resend.dev
# Cliente OAuth 2.0 tipo "Web application" en Google Cloud Console. Mientras la pantalla de
# consentimiento siga en estado "Testing", solo pueden iniciar sesión las cuentas de Google
# agregadas explícitamente como "Test users" ahí — mismo límite en espíritu que el modo sandbox
# de Resend arriba.
GOOGLE_CLIENT_ID=...apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=GOCSPX-...
PORT=3000
# Cloudflare R2 (foto de perfil del entrenador + audio de notas de voz) — opcional: sin esto
# configurado, esas subidas responden 503 en vez de romper el resto del servidor. R2_PUBLIC_URL
# es la URL pública del bucket (ej. https://pub-xxxx.r2.dev), sin slash final.
R2_ACCOUNT_ID=...
R2_ACCESS_KEY_ID=...
R2_SECRET_ACCESS_KEY=...
R2_BUCKET_NAME=remote-coach-photos
R2_PUBLIC_URL=https://pub-xxxx.r2.dev
# Transcripción de notas de voz (Whisper, OpenAI) — opcional: sin esto, jobs:transcribe-voice-notes
# se salta en vez de fallar (ver isTranscriptionConfigured en lib/transcription.ts).
OPENAI_API_KEY=sk-...
